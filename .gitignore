# Privileged Firebase Admin credentials — NEVER commit these.
# The Phase 04 admin-provisioning tool reads credentials through
# GOOGLE_APPLICATION_CREDENTIALS or gcloud application-default credentials.
*service-account*.json
*serviceAccountKey*.json
serviceAccount*.json

# Firebase Web App configuration for the Firebase project: abdeldjalil-portfolio
#
# These values are public client configuration, not secrets. They are still environment-specific,
# so real values belong in .env.local (gitignored) and must never be committed.
#
# Copy this file to .env.local and fill in the values from the Firebase console:
# Project settings -> Your apps -> Web app -> SDK setup and configuration.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=abdeldjalil-portfolio
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional abuse protection for the analytics callable. Register the app with Firebase App Check first.
VITE_FIREBASE_APPCHECK_RECAPTCHA_ENTERPRISE_KEY=

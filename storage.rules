rules_version = '2';

/**
 * Abdeldjalil Portfolio — Cloud Storage Security Rules.
 *
 * Security boundary:
 * - only the trusted Phase 04 admin claim can write/delete;
 * - public content media is single-object readable, never listable;
 * - SVG is excluded from uploaded media;
 * - draft project media is admin-only and validated before staging.
 */
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isSafeSegment(seg) {
      return seg is string && seg.size() > 0 && seg.size() <= 100
        && seg.matches('^[A-Za-z0-9][A-Za-z0-9._-]*$');
    }

    function isRasterImage() {
      return request.resource.contentType in [
        'image/png',
        'image/jpeg',
        'image/webp',
        'image/avif'
      ];
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function canWriteImage(maxBytes) {
      return isAdmin() && isRasterImage() && request.resource.size <= maxBytes;
    }

    function canWritePdf(maxBytes) {
      return isAdmin() && isPdf() && request.resource.size <= maxBytes;
    }

    match /profile/avatar/{fileName} {
      allow get: if true;
      allow create: if isSafeSegment(fileName) && canWriteImage(2097152);
      allow update: if isSafeSegment(fileName) && canWriteImage(2097152);
      allow delete: if isAdmin();
    }

    match /profile/resume/{fileName} {
      allow get: if true;
      allow create: if isSafeSegment(fileName) && canWritePdf(10485760);
      allow update: if isSafeSegment(fileName) && canWritePdf(10485760);
      allow delete: if isAdmin();
    }

    match /projects/{projectId}/thumbnail/{fileName} {
      allow get: if true;
      allow create: if isSafeSegment(projectId) && isSafeSegment(fileName)
        && canWriteImage(5242880);
      allow update: if isSafeSegment(projectId) && isSafeSegment(fileName)
        && canWriteImage(5242880);
      allow delete: if isAdmin();
    }

    match /projects/{projectId}/gallery/{fileName} {
      allow get: if true;
      allow create: if isSafeSegment(projectId) && isSafeSegment(fileName)
        && canWriteImage(5242880);
      allow update: if isSafeSegment(projectId) && isSafeSegment(fileName)
        && canWriteImage(5242880);
      allow delete: if isAdmin();
    }

    match /services/{serviceId}/icon/{fileName} {
      allow get: if true;
      allow create: if isSafeSegment(serviceId) && isSafeSegment(fileName)
        && canWriteImage(1048576);
      allow update: if isSafeSegment(serviceId) && isSafeSegment(fileName)
        && canWriteImage(1048576);
      allow delete: if isAdmin();
    }

    match /skills/{skillId}/icon/{fileName} {
      allow get: if true;
      allow create: if isSafeSegment(skillId) && isSafeSegment(fileName)
        && canWriteImage(524288);
      allow update: if isSafeSegment(skillId) && isSafeSegment(fileName)
        && canWriteImage(524288);
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId}/avatar/{fileName} {
      allow get: if true;
      allow create: if isSafeSegment(reviewId) && isSafeSegment(fileName)
        && canWriteImage(2097152);
      allow update: if isSafeSegment(reviewId) && isSafeSegment(fileName)
        && canWriteImage(2097152);
      allow delete: if isAdmin();
    }

    // Draft project media remains private until promotion to a public content path.
    match /drafts/{scope}/{fileName} {
      allow read: if isAdmin()
        && isSafeSegment(scope)
        && isSafeSegment(fileName);

      allow create, update: if isAdmin()
        && isSafeSegment(scope)
        && isSafeSegment(fileName)
        && scope.matches('^project-[A-Za-z0-9][A-Za-z0-9._-]*-(thumbnail|gallery)$')
        && isRasterImage()
        && request.resource.size <= 5242880;

      allow delete: if isAdmin()
        && isSafeSegment(scope)
        && isSafeSegment(fileName);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
